{
  "schema_version": "1.0",
  "id": "live-transcribe",
  "name": "Audio8-ASR-Infinite Streaming Transcription",
  "source": {
    "repository": "https://github.com/APLUX-Agora/audio8-asr-infinite-demo.git",
    "revision": "main"
  },
  "workspace": {
    "configurable": true,
    "code": "code",
    "resources": "resources",
    "configuration": "agora.env"
  },
  "variants": [
    {
      "clock_ms": 80,
      "repository": "APLUX-Agora/Audio8-ASR-Infinite-80ms",
      "entrypoint": "models.json"
    },
    {
      "clock_ms": 160,
      "repository": "APLUX-Agora/Audio8-ASR-Infinite-160ms",
      "entrypoint": "models.json"
    }
  ],
  "targets": {
    "QCS8550": {
      "ubuntu": "22.04",
      "model_target": "QCS8550",
      "qualified": true
    },
    "QCS8625": {
      "ubuntu": "22.04",
      "model_target": "QCS8625",
      "qualified": false
    },
    "IQ8": {
      "ubuntu": "24.04",
      "model_target": "IQ8",
      "qualified": false
    },
    "IQ9": {
      "ubuntu": "24.04",
      "model_target": "IQ9",
      "qualified": false
    }
  },
  "runtime": {
    "sdk": "0.9.0",
    "qnn": "2.48",
    "aidlite_qualified": "2.5.0.284",
    "python": [
      "3.10",
      "3.11",
      "3.12"
    ]
  },
  "documentation": "docs/AGORA_DEPLOY.md",
  "note": "Global configuration contains only workspace and SoC. Main contains common resources and targets/<SoC> folders. Download with the official HF CLI. Only QCS8550/Ubuntu22.04 is currently qualified end-to-end.",
  "resource_selection": {
    "method": "hf download",
    "revision": "main",
    "common_exclude": "targets/*",
    "target_include": "targets/$AGORA_SOC/*"
  },
  "application_configuration": {
    "audio_clock": "models.json:audio_clock_ms",
    "web_port": "demo_server.py --port (default 8765)"
  }
}
