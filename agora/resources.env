# Legacy filtered checkout support. New deployments use the official HF CLI with main/targets/<SoC>.
# Audio8 resource selection maintained by this project, not by Agora's global configuration.
# Source this file from Bash after agora.env. It does not download or install anything.
# An ignored source error must never turn into an unfiltered HF download.
AUDIO8_LFS_INCLUDE="__unsupported_soc__"
unset AUDIO8_MODEL_TARGET
case "${AGORA_SOC:-}" in
  QCS8550) AUDIO8_MODEL_TARGET=QCS8550 ;;
  QCS8625) AUDIO8_MODEL_TARGET=QCS8625 ;;
  IQ8) AUDIO8_MODEL_TARGET=IQ8 ;;
  IQ9) AUDIO8_MODEL_TARGET=IQ9 ;;
  *) printf 'Audio8 has no resource target for SoC: %s\n' "${AGORA_SOC:-not selected}" >&2; return 1 ;;
esac
AUDIO8_LFS_INCLUDE="embedding.bin,mel_filters.npy,rotation.npy,token_bytes.json,tokenizer.json,frontend/*,prefix/*,semantic_vad/*,targets/$AUDIO8_MODEL_TARGET/*"
