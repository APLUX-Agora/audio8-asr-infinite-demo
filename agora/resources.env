# Audio8 resource selection maintained by this project, not by Agora's global configuration.
# Source this file from Bash after agora.env. It does not download or install anything.
# An ignored source error must never turn into an unfiltered HF download.
AUDIO8_DOWNLOAD_PATTERNS=('__unsupported_soc__')
unset AUDIO8_MODEL_TARGET
case "${AGORA_SOC:-}" in
  QCS8550) AUDIO8_MODEL_TARGET=qcs8550_qnn248 ;;
  QCS8625) AUDIO8_MODEL_TARGET=qcs8625_qnn248 ;;
  IQ8) AUDIO8_MODEL_TARGET=qcs8275_qnn248 ;;
  IQ9) AUDIO8_MODEL_TARGET=qcs9075_qnn248 ;;
  *) printf 'Audio8 has no resource target for SoC: %s\n' "${AGORA_SOC:-not selected}" >&2; return 1 ;;
esac
AUDIO8_DOWNLOAD_PATTERNS=(
  README.md models.json agora-model.json SHA256SUMS NOTICE 'LICENSES/*'
  embedding.bin mel_filters.npy rotation.npy token_bytes.json tokenizer.json
  'frontend/*' 'prefix/*' 'semantic_vad/*' "targets/$AUDIO8_MODEL_TARGET/*"
)
